NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/teamsync
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173

# Optional email (password reset). Leave SMTP_HOST empty in development: the reset link is then
# printed in the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TeamSync <no-reply@teamsync.local>
